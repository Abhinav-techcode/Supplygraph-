# ==============================================================================
# SupplyGraph Environment Configuration Template (.env.example)
# Copy to .env for local overrides. NEVER commit actual production secrets to Git.
# ==============================================================================

# Application Profile & Server
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL Relational Truth Database
POSTGRES_DB=supplygraph
POSTGRES_USER=supplygraph_user
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_PORT=5432
SUPPLYGRAPH_DB_PORT=5433

# Java Virtual Machine Tuning
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Flyway Database Migration
SPRING_FLYWAY_ENABLED=true

# Security & Rate Limiting Boundaries
SUPPLYGRAPH_SECURITY_RATE_LIMIT_SIMULATION=10
SUPPLYGRAPH_SECURITY_MAX_UPLOAD_MB=10

# Spring AI LLM Provider Configuration (Optional for real cloud LLMs)
# Defaults to pure Java deterministic mock agent provider if unconfigured
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_ANTHROPIC_API_KEY=

